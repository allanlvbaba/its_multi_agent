# ======================================================================
# ITS 主服务配置模板 —— 复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# ======================================================================

# LLM配置（硅基流动，主模型客户端）
SF_API_KEY=sk-your-siliconflow-key
SF_BASE_URL=https://api.siliconflow.cn/v1
MAIN_MODEL_NAME=Qwen/Qwen3-32B

# 阿里百炼（子模型客户端）
AL_BAILIAN_API_KEY=sk-your-bailian-key
AL_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUB_MODEL_NAME=qwen3-max

# MySQL配置（门店查询工具用；无此库不影响启动）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=its
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10
MYSQL_MAX_CONNECTIONS=5

# MCP配置
# 百炼 WebSearch MCP（注意：必须用 /mcp 端点，/sse 已被阿里云下线）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# 搜索MCP专用百炼key（与子模型key解耦）
DASHSCOPE_API_KEY=sk-your-bailian-key
# 百度地图AK（百度地图开放平台申请，不是百炼key）
BAIDUMAP_AK=your-baidu-map-ak

# 知识库服务地址
KNOWLEDGE_BASE_URL=http://127.0.0.1:8001
