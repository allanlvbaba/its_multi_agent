# ======================================================================
# 知识库服务配置模板 —— 复制为 .env 并填入真实值
# ======================================================================

# 硅基流动（LLM 与 Embedding 共用）
API_KEY=sk-your-siliconflow-key
BASE_URL=https://api.siliconflow.cn/v1
MODEL=Qwen/Qwen3-32B
# 向量模型（更换后必须重建向量库：python -m cli.upload_cli）
EMBEDDING_MODEL=BAAI/bge-m3

# 爬虫目标站（知识文档来源）
KNOWLEDGE_BASE_URL=https://iknow.lenovo.com.cn
