# ======================================================================
# Agents SDK 教程配置模板 —— 复制为 .env 并填入真实值
# ======================================================================

# 主力模型（任选一家 OpenAI 兼容服务商）
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL_NAME=Qwen/Qwen3-32B

# 硅基流动
SF_API_KEY=sk-your-siliconflow-key
SF_BASE_URL=https://api.siliconflow.cn/v1
SF_MODEL_NAME=Qwen/Qwen3-32B

# 阿里百炼
AL_BAILIAN_API_KEY=sk-your-bailian-key
AL_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AL_BAILIAN_MODEL_NAME=qwen3-max
